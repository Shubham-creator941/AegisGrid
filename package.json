{
  "name": "aegis-grid",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "prebuild": "npm run build --workspace=shared",
    "build": "npm run build --workspaces --if-present",
    "pretypecheck": "npm run build --workspace=shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "echo \" No tests yet\\ -w shared",
    "lint": "npm run lint --workspaces --if-present"
  }
}
